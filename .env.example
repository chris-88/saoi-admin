# Browser environment. Nothing secret belongs here — every VITE_* value ships to the client.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Leave blank to disable browser error reporting.
VITE_SENTRY_DSN=

# GitHub Pages base path: "/<repo>/", or "/" with a custom domain.
VITE_BASE_PATH=/

# saoi-api, e.g. https://api.saoi.ie . Required: the console shows a setup notice without it.
VITE_SAOI_API_URL=
